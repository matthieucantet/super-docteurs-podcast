---
const links = [{ href: '#episodes', label: 'Les épisodes' }, { href: '#newsletter', label: 'La newsletter' }, { href: '#suivre', label: 'Écouter' }, { href: '#contact', label: 'Contact' }];
---
<header class="site-header"><nav class="container site-nav" aria-label="Navigation principale"><a class="brand" href="/" aria-label="Super Docteurs, accueil"><span class="brand-mark" aria-hidden="true"><img src="/brand-symbol.svg" alt="" /></span><span>SUPER<br />DOCTEURS</span></a><div class="site-nav__links">{links.map((link) => <a href={link.href}>{link.label}</a>)}</div><a class="button button--green site-nav__cta" href="#newsletter">S'abonner <span aria-hidden="true">→</span></a></nav></header>
