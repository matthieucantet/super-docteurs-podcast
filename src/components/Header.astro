---
const links = [
  { href: '#accueil', label: 'Accueil' },
  { href: '#podcast', label: "L'esprit du podcast" },
  { href: '#suivre', label: 'Écouter / regarder le podcast' },
  { href: '#newsletter', label: 'Newsletter' },
  { href: '#partenaires', label: 'Partenariats' },
];
---
<header class="site-header"><nav class="container site-nav" aria-label="Navigation principale"><a class="brand" href="#accueil" aria-label="Super Docteurs, accueil"><img class="brand-logo" src="/logo-super-docteurs.png" width="854" height="300" alt="Super Docteurs" /></a><div class="site-nav__links">{links.map(link => <a href={link.href}>{link.label}</a>)}</div><details class="mobile-menu"><summary>Menu</summary><div>{links.map(link => <a href={link.href}>{link.label}</a>)}</div></details></nav></header>
